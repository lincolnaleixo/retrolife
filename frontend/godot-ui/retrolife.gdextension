[configuration]

entry_symbol = "gdext_rust_init"
compatibility_minimum = "4.7"
reloadable = true

[libraries]

macos.debug = "res://bin/libretrolife_godot.dylib"
macos.release = "res://bin/libretrolife_godot.dylib"
macos.debug.arm64 = "res://bin/libretrolife_godot.dylib"
macos.release.arm64 = "res://bin/libretrolife_godot.dylib"
linux.debug.x86_64 = "res://bin/libretrolife_godot.so"
linux.release.x86_64 = "res://bin/libretrolife_godot.so"
