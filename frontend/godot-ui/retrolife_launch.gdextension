[configuration]
entry_symbol = "gdext_rust_init"
compatibility_minimum = "4.7"
reloadable = true

[libraries]
macos.debug = "res://bin/libretrolife_launch_bridge.dylib"
macos.release = "res://bin/libretrolife_launch_bridge.dylib"
linux.debug.x86_64 = "res://bin/libretrolife_launch_bridge.so"
linux.release.x86_64 = "res://bin/libretrolife_launch_bridge.so"
