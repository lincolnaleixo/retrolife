; Engine configuration file.
; Prefer editing this file through the Godot editor.

config_version=5

[application]

config/name="RetroLife"
config/icon="res://assets/brand/retrolife-icon.png"
config/version="0.1.0"
run/main_scene="res://scenes/Main.tscn"
config/use_custom_user_dir=true
config/custom_user_dir_name="io.github.lincolnaleixo.retrolife"
boot_splash/image="res://assets/brand/retrolife-splash.png"
boot_splash/bg_color=Color(0.028, 0.034, 0.061, 1)
boot_splash/stretch_mode=0
boot_splash/minimum_display_time=350
boot_splash/use_filter=true

[display]

window/size/viewport_width=2560
window/size/viewport_height=1440
window/size/window_width_override=2560
window/size/window_height_override=1440
window/size/borderless=true
window/size/min_width=1024
window/size/min_height=640
window/stretch/mode="disabled"
window/stretch/aspect="expand"

[rendering]

textures/vram_compression/import_etc2_astc=true
