  "bottomDock": {
    "visibleWithoutCommittedSelection": false,
    "centerFraction": [
      0.5,
      0.885
    ],
    "sizeFraction": [
      0.48,
      0.105
    ],
    "cornerRadiusPxAtReference": 24,
    "slotSizeFraction": [
      0.205,
      0.023
    ],
    "slotCenterFraction": [
      0.5,
      0.844
    ],
    "restingOcclusionFraction": 0.27,
    "minimumVisibleCartridgeFraction": 0.7,
    "lighting": {
      "rimIntensity": 0.34,
      "slotGlowIntensity": 0.18,
      "shadowOpacity": 0.48
    },
    "rules": [
      "The dock is an abstract product surface, not a console or a console silhouette.",
      "The cartridge remains recognizable and readable after seating.",
      "The slot may not cover the label title area.",
      "The dock does not move during normal selection animation.",
      "The docked cartridge identity is stable across launch, failure, cancellation, and return."
    ]
  },
  "motion": {
    "normal": {
      "focusChangeMs": 190,
      "confirmInputLockMs": 40,
      "dockingTotalMs": 620,
      "undockingTotalMs": 540,
      "launchReturnSettleMs": 240,
      "easing": {
        "focus": "cubicOut",
        "dockingTravel": "quintInOut",
        "seat": "backOutLimited",
        "undocking": "quintInOut"
      },
      "dockingKeyframes": [
        {
          "timeMs": 0,
          "pose": "browseFocused",
          "scaleMultiplier": 1.0,
          "shadowMultiplier": 1.0
        },
        {
          "timeMs": 70,
          "pose": "browseFocused",
          "offsetFraction": [
            0.0,
            -0.018
          ],
          "scaleMultiplier": 1.015,
          "shadowMultiplier": 1.12
        },
        {
          "timeMs": 250,
          "interpolateToPose": "dockApproach",
          "scaleMultiplier": 0.91,
          "shadowMultiplier": 0.82
        },
        {
          "timeMs": 480,
          "interpolateToPose": "docked",
          "seatOvershootPxAtReference": 7,
          "scaleMultiplier": 1.0,
          "shadowMultiplier": 0.56
        },
        {
          "timeMs": 620,
          "pose": "docked",
          "seatOvershootPxAtReference": 0,
          "scaleMultiplier": 1.0,
          "shadowMultiplier": 0.48
        }
      ],
      "reverseRule": "Cancel during docking reverses continuously from the current normalized progress. It never teleports to an endpoint.",
      "resizeRule": "Viewport changes recompute normalized endpoints and preserve current normalized animation progress."
    },
    "reducedMotion": {
      "transitionMs": 120,
      "translationEnabled": false,
      "rotationEnabled": false,
      "scalePulseEnabled": false,
      "behavior": "Crossfade browse chrome to docked chrome, place the cartridge directly in the docked pose, and preserve identical committed state and focus semantics."
    },
    "rapidInput": {
      "navigationCoalescingMs": 65,
      "confirmDuringDocking": "ignore",
      "confirmWhileDocked": "activateFocusedDockAction",
      "backDuringDocking": "reverseFromCurrentProgress",
      "navigationWhileDocked": "disabledUntilUndocked",
      "duplicateLaunchProtection": true
    }
  },
  "stateMachine": {
    "initialState": "browseFocused",
    "states": [
      {
        "id": "browseIdle",
        "selectionCommitted": false,
        "dockVisible": false,
        "navigationEnabled": true
      },
      {
        "id": "browseFocused",
        "selectionCommitted": false,
        "dockVisible": false,
        "navigationEnabled": true
      },
      {
        "id": "commitPending",
        "selectionCommitted": true,
        "dockVisible": true,
        "navigationEnabled": false
      },
      {
        "id": "docking",
        "selectionCommitted": true,
        "dockVisible": true,
        "navigationEnabled": false
      },
      {
        "id": "docked",
        "selectionCommitted": true,
        "dockVisible": true,
        "navigationEnabled": false
      },
      {
        "id": "launching",
        "selectionCommitted": true,
        "dockVisible": true,
        "navigationEnabled": false
      },
      {
        "id": "launchReturn",
        "selectionCommitted": true,
        "dockVisible": true,
        "navigationEnabled": false
      },
      {
        "id": "undocking",
        "selectionCommitted": true,
        "dockVisible": true,
        "navigationEnabled": false
      },
      {
        "id": "recoverableError",
        "selectionCommitted": true,
        "dockVisible": true,
        "navigationEnabled": false
      }
    ],
    "transitions": [
      {
        "from": "browseIdle",
        "event": "focusGame",
        "to": "browseFocused",
        "focusAfter": "browse:game:{gameId}"
      },
      {
        "from": "browseFocused",
        "event": "navigate",
        "to": "browseFocused",
        "focusAfter": "browse:game:{newGameId}"
      },
      {
        "from": "browseFocused",
        "event": "confirm",
        "to": "commitPending",
        "focusAfter": "none"
      },
      {
        "from": "commitPending",
        "event": "nextFrame",
        "to": "docking",
        "focusAfter": "none"
      },
      {
        "from": "docking",
        "event": "animationCompleted",
        "to": "docked",
        "focusAfter": "dock:primary"
      },
      {
        "from": "docking",
        "event": "cancel",
        "to": "undocking",
        "reverseFromCurrentProgress": true,
        "focusAfter": "none"
      },
      {
        "from": "docked",
        "event": "cancel",
        "to": "undocking",
        "focusAfter": "none"
      },
      {
        "from": "docked",
        "event": "launch",
        "to": "launching",
        "focusAfter": "none"
      },
      {
        "from": "launching",
        "event": "launchCompleted",
        "to": "launchReturn",
        "focusAfter": "none"
      },
      {
        "from": "launching",
        "event": "launchFailed",
        "to": "recoverableError",
        "focusAfter": "dock:retry"
      },
      {
        "from": "launching",
        "event": "launchCancelled",
        "to": "docked",
        "focusAfter": "dock:primary"
      },
      {
        "from": "launchReturn",
        "event": "settleCompleted",
        "to": "docked",
        "focusAfter": "dock:primary"
      },
      {
        "from": "recoverableError",
        "event": "dismissError",
        "to": "docked",
        "focusAfter": "dock:primary"
      },
      {
        "from": "undocking",
        "event": "animationCompleted",
        "to": "browseFocused",
        "focusAfter": "browse:game:{committedGameId}"
      }
    ],
    "invariants": [
      "Committed game identity never changes between commitPending and completed undocking.",
      "Exactly one semantic focus target exists after every terminal transition.",
      "No transition may emit more than one launch request.",
      "Filtering or catalog refresh may not replace the committed game during docking or docked states.",
      "Missing media may update the cartridge label surface, but may not change selection identity or animation progress."
    ]
  },
  "chrome": {
    "browse": {
