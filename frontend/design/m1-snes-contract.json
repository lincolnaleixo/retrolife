    "file": "frontend/design/m1-snes-motion-storyboard.svg",
    "normalMotionPanels": 8,
    "reducedMotionPanels": 3
  },
  "m2Handoff": {
    "locked": [
      "reference region and cartridge family",
      "camera composition and normalized poses",
      "bottom dock geometry and occlusion",
      "normal and reduced-motion state semantics",
      "animation durations and easing families",
      "semantic focus restoration rules",
      "normal flow never displays a console"
    ],
    "allowedCalibration": [
      "physical mesh dimensions within the recorded tolerance",
      "material roughness and micro-normal detail",
      "lighting intensity within 10 percent while preserving contrast",
      "label safe inset after measured geometry exists"
    ],
    "requiresM1Revision": [
      "changing the reference region",
      "showing a console",
      "moving or redesigning the dock",
      "changing selection commit semantics",
      "changing reverse/cancel behavior",
      "changing reduced-motion state equivalence"
    ]
  },
  "acceptance": {
    "implementationChecksCompleteWhen": [
      "contract JSON validates",
      "golden frame SVG contains all six states",
      "motion storyboard contains normal and reduced-motion sequences",
      "documentation maps every M1 scope item to a locked decision",
      "M2 handoff has no unresolved implementation choices"
    ],
    "ownerApprovalRequired": true,
    "ownerApprovalStatus": "pending"
  }
}
